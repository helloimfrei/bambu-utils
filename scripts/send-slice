#!/bin/sh
set -eu

usage() {
    printf '%s\n' \
        'Usage: send-slice [--print] FILE [OPTIONS]' \
        '' \
        'Upload a sliced .gcode.3mf or .gcode file to the configured printer.' \
        'The default is upload only. Add --print to start the uploaded file.' \
        '' \
        'Examples:' \
        '  ./scripts/send-slice part.gcode.3mf' \
        '  ./scripts/send-slice --print part.gcode.3mf --plate 2 --ams 0,1'
}

start_print=false
if [ "${1:-}" = "--print" ]; then
    start_print=true
    shift
fi

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    '')
        usage >&2
        exit 2
        ;;
esac

slice=$1
shift
if [ ! -f "$slice" ]; then
    printf 'error: sliced file does not exist: %s\n' "$slice" >&2
    exit 1
fi

case "$slice" in
    /*) ;;
    *) slice="$(pwd)/$slice" ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(dirname -- "$script_dir")
cd "$repo_dir"

if [ "$start_print" = true ]; then
    exec uv run bambu-utils print "$slice" "$@"
fi
exec uv run bambu-utils upload "$slice" "$@"
