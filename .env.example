# Copy to .env and fill in the values shown by the printer.
BAMBU_HOST=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=
BAMBU_PRINTER_MODEL=
BAMBU_TIMEOUT=15

# Dashboard defaults. Keep it on loopback when using Tailscale Serve.
BAMBU_UI_HOST=127.0.0.1
BAMBU_UI_PORT=8000
# BAMBU_DATA_DIR=~/.local/share/bambu-utils
