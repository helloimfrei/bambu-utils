[Unit]
Description=bambu-utils printer dashboard
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=bambu
Group=bambu
WorkingDirectory=/opt/bambu-utils
EnvironmentFile=/opt/bambu-utils/.env
Environment=BAMBU_DATA_DIR=/var/lib/bambu-utils
ExecStart=/opt/bambu-utils/.venv/bin/bambu-dashboard
Restart=on-failure
RestartSec=5
StateDirectory=bambu-utils
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
